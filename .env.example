# TransTools Configuration
# Copy to .env and edit as needed

# Language: es (Spanish), en (English)
LANGUAGE=es

# UI theme
UI_BACKGROUND=#10161B
UI_FOREGROUND=#F2F5F7
UI_BUTTON_BG=#1E2D38
UI_BUTTON_WIDTH=12
UI_BUTTON_WIDTH_WIDE=20
UI_BUTTON_FG=#F5F7FA
UI_BUTTON_FG_CANCEL=#FFF1F2
UI_BUTTON_FG_ACCENT2=#FFF4D6
UI_FONT_SIZE=16
UI_FONT_FAMILY=Bahnschrift
UI_PADDING=6

# Paths
FILE_OUTPUT_DIR=output
FILE_DATA_FORMAT=json

# Recording
SAVE_AUDIO=false
RECORD_DURATION_SEC=5

# Logging
LOG_LEVEL=INFO
LOG_FILE=transtools.log
LOG_CONSOLE=true
