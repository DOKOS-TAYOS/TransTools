# TransTools Configuration
# Copy to .env and edit as needed

# Language: es (Spanish), en (English)
LANGUAGE=es

# UI theme
UI_BACKGROUND=#181818
UI_FOREGROUND=#CCCCCC
UI_BUTTON_BG=#1F1F1F
UI_BUTTON_WIDTH=12
UI_BUTTON_WIDTH_WIDE=20
UI_BUTTON_FG=lime green
UI_BUTTON_FG_CANCEL=red2
UI_BUTTON_FG_ACCENT2=yellow
UI_FONT_SIZE=16
UI_FONT_FAMILY=Bahnschrift
UI_PADDING=6

# Paths
FILE_OUTPUT_DIR=output
FILE_DATA_FORMAT=json

# Recording
SAVE_AUDIO=false
RECORD_DURATION_SEC=5

# Logging
LOG_LEVEL=INFO
LOG_FILE=transtools.log
LOG_CONSOLE=true
